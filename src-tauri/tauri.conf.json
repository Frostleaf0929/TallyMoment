{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TallyMoment",
  "version": "0.2.0",
  "identifier": "com.tallymoment.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "拾刻 · TallyMoment",
        "width": 1080,
        "height": 700,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "resizable": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "acrylic",
            "mica"
          ],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$EXE/Data/models/**",
          "$APPDATA/TallyMoment/Data/models/**",
          "$EXE/Data/wallpapers/**",
          "$APPDATA/TallyMoment/Data/wallpapers/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
